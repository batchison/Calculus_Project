DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaUpToConstant.pl",
  "parserRoot.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$m = random(3,6,1);
$n = random(2,8,1);
$b = random(2,8,1);
if($envir{problemSeed}==1){$m=3;$n=2;$b=2;};
Context("Fraction");
Context()->variables->add(t=>"Real");
parser::Root->Enable;
$f = Formula("root($m,t) + 1/t^$n + $b^t");
$A = Fraction(1/(1/$m + 1));
$M = Fraction(1/$m + 1);
Context()->flags->set(reduceConstantFunctions=>0);
$F = FormulaUpToConstant("$A*t^($M) - 1/(($n-1) t^($n-1)) + $b^t/ln($b)")->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the given indefinite integral.

[`\int \left([$f]\right)\, dt`]

[_]{$F}{40}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
