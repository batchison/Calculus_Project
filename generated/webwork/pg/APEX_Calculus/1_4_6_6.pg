DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$c = non_zero_random(-9,9,1);
$low = 0;
$high = random(2,6,1);
if($envir{problemSeed}==1){$c=-1;$high=4;};
Context("Fraction");
Context()->noreduce('(-x)-y','(-x)+y');
$F = Formula("1/3(x + $c)^3")->reduce;
$f = Formula("(x + $c)^2")->reduce;
$r = Fraction($F->eval(x=>$high) - $F->eval(x=>$low));

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
