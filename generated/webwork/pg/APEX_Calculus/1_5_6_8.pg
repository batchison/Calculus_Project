############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
Context('Numeric');
$a = 0;
$b = 4;
$n = 4;
$f = Formula("sqrt(x)");
$F = Formula("2/3*x^(3/2)");
$delta_x = ($b - $a)/$n;
@l = ();
$trap = 0;
$simp = 0;
foreach $i (0..$n-1) {
  push @l, $i*$delta_x + $a;
}
$flip = 1;
foreach $i (@l) {
  $trap += $f->eval(x=>$i) + $f->eval(x=>($i + $delta_x));
  if ($flip == 1) {
    $simp += $f->eval(x=>$i) + 4*$f->eval(x=>($i + $delta_x)) + $f->eval(x=>($i+2*$delta_x));
    $flip = 0;
  } else {
    $flip = 1;
  }
}
$trap = $trap*$delta_x/2;
$simp = $simp*$delta_x/3;
$exact = $F->eval(x=>$b) - $F->eval(x=>$a);

############################################################
# Body
############################################################

BEGIN_PGML
Approximate the definite integral with the Trapezoidal Rule and Simpson's Rule, with [`n=4\text{.}`] Then find the exact value.

For the integral [`\int_{0}^{4} \sqrt x\, dx\text{:}`]

END_PGML

############################################################
# Scaffold
############################################################
Scaffold::Begin(numbered => 1,is_open => "correct_or_first_incorrect",can_open => always,);

############################################################
# Section
############################################################
Section::Begin("");

BEGIN_PGML
Approximate using the trapezoidal rule.

[_]{$trap}{20} 

END_PGML

Section::End();

############################################################
# Section
############################################################
Section::Begin("");

BEGIN_PGML
Approximate using Simpson's rule.

[_]{$simp}{20} 

END_PGML

Section::End();

############################################################
# Section
############################################################
Section::Begin("");

BEGIN_PGML
Find the exact value.

[_]{$exact}{20} 

END_PGML

Section::End();

Scaffold::End();

