############################################################
# PG Setup Code
############################################################
Context('Numeric');
($low,$high) = num_sort(random_subset(2,1..4));
if($envir{problemSeed}==1){$low=1;$high=4;};
$f = Formula("e^x")->reduce;
$r = Formula("e^$high - e^$low");

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
