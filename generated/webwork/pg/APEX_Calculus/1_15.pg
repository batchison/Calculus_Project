############################################################
# PG Setup Code
############################################################
$a=random(1,9,1);
$b=list_random(2,3,5,6,7,11,13);
if($envir{problemSeed}==1){$a=1;$b=5;};
$f=Formula("1/(x^2-$a^2)");
$g=Formula("sqrt($b-x)");
$h=Formula("sqrt($b-x^2)");
Context("Interval");
Context()->flags->set(reduceConstantFunctions=>0);
@cont=(
  List(Interval("(-inf,inf)")),
  List(Interval("(-inf,-$a)"), Interval("(-$a,$a)"), Interval("($a,inf)")),
  List(Interval("(-inf,$b]")),
  List(Interval("[-sqrt($b),sqrt($b)]"))
);

############################################################
# Body
############################################################

BEGIN_PGML
Give maximal intervals on which each of the following functions are continuous.

[@KeyboardInstructions('If there is more than one interval for an answer, enter the intervals as a list separated by commas.')@]**

END_PGML

############################################################
# Scaffold
############################################################
Scaffold::Begin(numbered => 1,is_open => "correct_or_first_incorrect",can_open => always,);

