DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
Context('Numeric');
$trig = list_random('sin','cos');
$lh = list_random(['0','pi/2'],['0','pi'],['pi/2','pi']);
if($envir{problemSeed}==1){$trig='cos';$lh=['pi/2','pi'];};
$low = Formula($lh->[0]);
$high = Formula($lh->[1]);
$f = Formula("$trig(x)");
$F = -$f->D('x')->reduce;
$r = $F->eval(x=>Real("$high")) - $F->eval(x=>Real("$low"));

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
