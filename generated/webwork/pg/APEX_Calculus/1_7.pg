############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
Context('Numeric');
$b=list_random(-9..6,6..9);
$c=non_zero_random(-5,5,1);
do{$a=non_zero_random(-5,5,0.1);}until($a!=$c);
if ($envir{problemSeed}==1){$a=-0.8;$b=9;$c=-5};
$f=Formula("(x^2-($a+$b)x+$a*$b)/(x^2-($a+$c)x+$a*$c)")->reduce;
$l=Real(($a-$b)/($a-$c));
@tabin=($a-0.1,$a-0.01,$a-0.001,$a+0.001,$a+0.01,$a+0.1);
@tabout=map{$f->eval(x=>$_)} @tabin;

############################################################
# Body
############################################################

BEGIN_PGML
Numerically approximate the following limits.

[@KeyboardInstructions('If you need to enter [`\infty\text{,}`] you may type [|infinity|]*, or just [|INF|]*. If the limit does not exist, you may type [|does not exist|]*, or just [|DNE|]*.')@]**

END_PGML

############################################################
# Scaffold
############################################################
Scaffold::Begin(numbered => 1,is_open => "correct_or_first_incorrect",can_open => always,);

############################################################
# Section
############################################################
Section::Begin("");

BEGIN_PGML
[`\lim\limits_{x\to [$a]^{+}}\left([$f]\right)`]

[_]{$l}{10}

END_PGML

Section::End();

############################################################
# Section
############################################################
Section::Begin("");

BEGIN_PGML
[`\lim\limits_{x\to [$a]^{-}}\left([$f]\right)`]

[_]{$l}{10}

END_PGML

Section::End();

Scaffold::End();

