############################################################
# PG Setup Code
############################################################
($s,$t,$u) = random_subset(3,'sin','cos','tan','sec','cot','csc');
$a = list_random(-1,1);
$b = list_random(-1,1);
$c = list_random(-1,1);
if($envir{problemSeed}==1){$s='cos';$c='sin';$d='tan';$a=-1;$b=-1;$c=1;};
Context()->noreduce('(-x)+y');
Context()->noreduce('(-x)-y');
$F = Formula("$a $s(x) + $b $t(x) + $c $u(x)")->reduce;
$f = $F->D('x')->reduce;
$F = FormulaUpToConstant("$F");

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the given indefinite integral.

[`\int \left([$f]\right)\, dx`]

[_]{$F}{40}

END_PGML

