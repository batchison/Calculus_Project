DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "parserMultiAnswer.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$lb = list_random(0,1);
$ub = $lb + 4;
if($envir{problemSeed}==1){$lb=0;};
Context()->variables->are(i=>'Real');
$f = ($lb == 0) ? Formula("(-1)^i") : Formula("(-1)^(i+1)");
@i = ($lb..$ub);
@fi = map{$f->eval(i=>$_) * Formula("e^$_")}(@i);
$f = ($lb == 0) ? Formula("(-e)^i") : Formula("-(-e)^i");
$string = join('+',@fi);
Context()->flags->set(reduceConstants=>0);
$terms = Formula("$string")->reduce;
$multians = MultiAnswer($lb, $ub, $f)->with(
  singleResult => 1,
  checker => sub {
      my ( $correct, $student, $self ) = @_;
      my ( $stulb, $stuub, $stuf ) = @{$student};
      my ( $corlb, $corub, $corf ) = @{$correct};
      if ($stuub - $stulb != $corub - $corlb) {Value::Error("Your sum does not have the correct number of terms");};
      @stui = ($stulb..$stuub);
      @stufi = map{$stuf->eval(i=>$_)}(@stui);
      @cori = ($corlb..$corub);
      @corfi = map{$corf->eval(i=>$_)}(@cori);
      $score = 1;
      for $j (0..$#corfi) {
        if ($stufi[$j] != $corfi[$j]) {
          $score = 0;
          last;
        }
      }
      return $score;
    }
);

############################################################
# Body
############################################################

BEGIN_PGML
Write the sum in summation notation.

[`[$terms]`]

[@KeyboardInstructions('If the sum were in sigma notation, [`\sum\limits_{i=\text{start}}^{\text{end}}(\text{summand expression})\text{,}`] enter the start value here.')@]**

[_]{$multians}{20}

[@KeyboardInstructions('If the sum were in sigma notation, [`\sum\limits_{i=\text{start}}^{\text{end}}(\text{summand expression})\text{,}`] enter the end value here.')@]**

[_]{$multians}{20}

[@KeyboardInstructions('If the sum were in sigma notation, [`\sum\limits_{i=\text{start}}^{\text{end}}(\text{summand expression})\text{,}`] enter the summand expression here.')@]**

[_]{$multians}{20}

END_PGML

############################################################
# End Problem
############################################################

