############################################################
# PG Setup Code
############################################################
($low,$high) = num_sort(random_subset(2,-4..-1));
($a,$b) = random_subset(2,-9..-1,1..9);
$m = random(2,5,1);
if($envir{problemSeed}==1){$low=-2;$high=-1;$a=4,$b=-2;$m=3;};
$f = Formula("$a + $b x^$m")->reduce;
Context("Fraction");
$r = Fraction(($a*$high + $b/($m+1)*$high**($m+1)) - ($a*$low + $b/($m+1)*$low**($m+1)));

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} \left([$f]\right)\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
