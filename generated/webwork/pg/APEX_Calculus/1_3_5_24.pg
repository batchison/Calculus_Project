############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$lb = 1;
$ub = random(16,30,1);
if($envir{problemSeed}==1){$ub=20;};
Context()->variables->are(i=>'Real');
$f = Formula("i^2")->reduce;
@i = ($lb..$ub);
@fi = map{$f->eval(i=>$_)}(@i);
$string = join('+',@fi);
$sum = Real($string);
$last = $ub**2;
$penultimate = ($ub - 1)**2;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the summation using Theorem[$NBSP]*1.3.7.

[`1+4+9+\cdots+[$penultimate]+[$last]`]

[_]{$sum}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
