DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaWithUnits.pl",
  "parserRoot.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$low = 0;
$n = random(3,5,1);
$high = list_random(2**$n,3**$n,4**$n);
if($envir{problemSeed}==1){$high=1;$n=4;$high=16;};
Context("Fraction");
Context()->variables->are(t=>'Real');
parser::Root->Enable;
$f = FormulaWithUnits("root($n,t) ft/s");
$F = Formula("t^(1/$n+1)/(1/$n+1)");
$D = FormulaWithUnits(Fraction($F->eval(t=>Real($high)) - $F->eval(t=>Real($low))), 'ft');

############################################################
# Body
############################################################

BEGIN_PGML
A velocity function is given for an object moving along a straight line. Find the displacement of the object over the given time interval.

[`v(t)=[$f]`] on [`[[$low],[$high]]`]

[_]{$D}{10}

END_PGML

############################################################
# End Problem
############################################################

