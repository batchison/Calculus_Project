$b = random(2,9,1);
$f0 = random(1,9,1);
if($envir{problemSeed}==1){$b=7;$f0=1;};
$f = Formula("$b^x");
Context()->flags->set(reduceConstantFunctions=>0);
$F = Formula("$b^x/ln($b) - $b^2/ln($b) + $f0");

############################################################
# Body
############################################################

BEGIN_PGML
Find the function determined by the given initial value problem.

[`\fp(x) = [$f]`] and [`f(2) = [$f0]`]

[_]{$F}{40}

END_PGML

