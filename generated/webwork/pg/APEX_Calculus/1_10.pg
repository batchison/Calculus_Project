$a=random(-9,9,1);
do{@L=(non_zero_random(-9,9,1),non_zero_random(-3,3,1));}until($L[0]!=$L[1]);
if($envir{problemSeed}==1){$a=2;@L=(3,-1)};
$L[2]=$L[0]+$L[1];
$L[3]=$L[0]*$L[1];
Context("Fraction");
$L[4]=Fraction($L[0]/$L[1]);
$L[5]=Fraction(($L[0])**($L[1]));
Context()->strings->add('does not exist'=>{alias=>'DNE'});

############################################################
# Body
############################################################

BEGIN_PGML
Let [`\lim\limits_{x\to[$a]} f(x) = [$L[0]]`] and [`\lim\limits_{x\to[$a]} g(x) = [$L[1]]\text{.}`] Evaluate the following limits.

[@KeyboardInstructions('If you need to enter [`\infty\text{,}`] you may type [|infinity|]*, or just [|INF|]*. If the limit does not exist, you may type [|does not exist|]*, or just [|DNE|]*.')@]**

END_PGML

