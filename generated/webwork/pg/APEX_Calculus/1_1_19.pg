############################################################

############################################################
# PG Setup Code
############################################################
Context('Numeric');
($G,$H) = ('sec','csc','tan','cot');
$c = list_random(-1,1);
if($envir{problemSeed}==1){$G='sec';$H=csc;$c=-1};
$F = Formula("$G(x) + $c*$H(x)")->reduce;
$f = $F->D('x')->reduce;
$F = FormulaUpToConstant("$F");

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the indefinite integral. Don't forget your constant of integration!

[`\int \left([$f]\right)\, dx`]

[_]{$F}{40}

END_PGML

############################################################
# End Problem
