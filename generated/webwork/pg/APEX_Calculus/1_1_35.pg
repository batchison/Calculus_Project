($fpp,$fp0,$f0) = random_subset(3,2..9);
if($envir{problemSeed}==1){$fpp=5;$fp0=7;$f0=3;};
Context("Fraction");
$a = Fraction($fpp,2);
$F = Formula("$a x^2 + $fp0 x + $f0");

############################################################
# Body
############################################################

BEGIN_PGML
Find the function determined by the given initial value problem.

[`\fpp(x)=[$fpp]`] and [`\fp(0)=[$fp0]\text{,}`] [`f(0)=[$f0]`]

[_]{$F}{40}

END_PGML

