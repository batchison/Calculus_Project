############################################################
# PG Setup Code
############################################################
Context('Numeric');
($m,$n) = random_subset(2,2..9);
if($envir{problemSeed}==1){$m=2;$n=3};
$f = Formula("x^$m x^$n")->reduce;
$F = FormulaUpToConstant("x^($m+$n+1)/($m+$n+1)")->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the indefinite integral. Don't forget your constant of integration!

[`\int [$f]\, dx`]

[_]{$F}{40}

END_PGML

############################################################
# End Problem
