Context('Numeric');
$n = random(1,9,1);
if($envir{problemSeed}==1){$n=1;};
$low = 1;
$high = Formula("e^$n")->reduce;
$F = Formula("ln(x)")->reduce;
$f = Formula("1/x")->reduce;
$r = $n;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

