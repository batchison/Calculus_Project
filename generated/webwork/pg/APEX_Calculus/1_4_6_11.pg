############################################################
# PG Setup Code
############################################################
$b = random(2,9,1);
$low = random(-3,-1,1);
$high = random(1,3,1);
if($envir{problemSeed}==1){$b=5;$low=-1;$high=1;};
$f = Formula("$b^x")->reduce;
Context("Fraction");
Context()->flags->set(reduceConstantFunctions=>0);
$r = Formula("($b**$high - 1/$b**(-$low))/ln($b)");

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
############################################################

