Context('Numeric');
$c = random(2,9,1);
if($envir{problemSeed}==1){$c=7;};
$f = Formula("$c/x");
$F = FormulaUpToConstant("$c*ln(abs(x))");

############################################################
# Body
############################################################

BEGIN_PGML
Find the general antiderivative of the given function.

[`f(x) = [$f]`]

[_]{$F}{40}

END_PGML

