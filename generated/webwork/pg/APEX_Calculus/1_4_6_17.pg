############################################################
# PG Setup Code
############################################################
$n = random(3,5,1);
($low,$high) = num_sort(random_subset(2,0**$n,1**$n,2**$n,3**$n,4**$n));
if($envir{problemSeed}==1){$n=3;$low=1;$high=8;};
parser::Root->Enable;
$f = Formula("root($n,x)")->reduce;
Context("Fraction");
$r = Fraction($high**(1/$n + 1)/(1/$n + 1) - $low**(1/$n + 1)/(1/$n + 1));

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
