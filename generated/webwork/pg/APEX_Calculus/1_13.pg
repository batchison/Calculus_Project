DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
($r,$s,$t) = random_subset(3,-9..-1,1..9);
$t += non_zero_random(-0.5,0.5,0.1);
if($envir{problemSeed}==1){$r=-7;$s=5;$t=5.5;};
$b=-($r+$t);
$c=$r*$t;
$B=-($s+$t);
$C=$s*$t;
$f=Formula("(x^2+$b x+$c)/(x^2+$B x+$C)");
Context("Fraction");
$L=Fraction(($t-$r)/($t-$s));

############################################################
# Body
############################################################

BEGIN_PGML
Approximate [`\displaystyle\lim_{x\to [$t]}[$f]\text{.}`]

[@KeyboardInstructions('If you need to enter [`\infty\text{,}`] you may type [|infinity|]*, or just [|INF|]*. If the limit does not exist, you may type [|does not exist|]*, or just [|DNE|]*.')@]**

[_]{$L}{10}

END_PGML

############################################################
# End Problem
############################################################

