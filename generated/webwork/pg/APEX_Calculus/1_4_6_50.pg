############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaWithUnits.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$trig = list_random('sin','cos');
$lh = list_random(['0','pi/2'],['0','pi'],['0','3*pi/2'],['pi/2','pi'],['pi/2','3*pi/2'],['pi','3*pi/2']);
if($envir{problemSeed}==1){$trig='cos';$lh=['0','pi/2'];};
$low = Formula($lh->[0]);
$high = Formula($lh->[1]);
Context()->variables->are(t=>'Real');
$f = FormulaWithUnits("$trig(t) ft/s^2");
$F = Formula("-$trig(t)")->D('t')->reduce;
$D = FormulaWithUnits($F->eval(t=>Real("$high")) - $F->eval(t=>Real("$low")), 'ft/s');

############################################################
# Body
############################################################

BEGIN_PGML
An acceleration function of an object moving along a straight line is given. Find the change of the object's velocity over the given time interval.

[`a(t)=[$f]`] on [`\left[[$low],[$high]\right]`]

[_]{$D}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
