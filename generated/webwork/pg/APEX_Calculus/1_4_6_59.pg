############################################################
# PG Setup Code
############################################################
$b = non_zero_random(-9,9,1);
$m = random(2,4,1);
Context()->variables->add(t=>'Real');
$low = random(1,9,1);
$high = Formula("x^$m");
$f = Formula("sin($b t^2)")->reduce;
$D = Formula("$m x^($m-1)sin($b x^(2*$m))")->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
Find [`F'(x)\text{.}`]

[`F(x) = \ds\int_{[$low]}^{[$high]} ([$f])\, dt`]

[_]{$D}{30}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
