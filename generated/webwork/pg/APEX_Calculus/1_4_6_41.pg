DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaWithUnits.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$low = 0;
$high = random(4,8,1);
$v0 = random(10,30,2);
if($envir{problemSeed}==1){$high=5;$v0=20};
$a = -32;
Context("Fraction");
Context()->variables->are(t=>'Real');
$f = FormulaWithUnits("$a t + $v0 ft/s");
$F = Formula("$a/2 t^2 + $v0 t");
$D = FormulaWithUnits(Fraction($F->eval(t=>Real($high)) - $F->eval(t=>Real($low))), 'ft');

############################################################
# Body
############################################################

BEGIN_PGML
A velocity function is given for an object moving along a straight line. Find the displacement of the object over the given time interval.

[`v(t)=[$f]`] on [`[[$low],[$high]]`]

[_]{$D}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
