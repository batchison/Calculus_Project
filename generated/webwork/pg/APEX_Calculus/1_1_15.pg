DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaUpToConstant.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
($a,$n) = random_subset(2,2..9);
if($envir{problemSeed}==1){$a=3;$n=2};
Context("Fraction");
Context()->variables->are(t=>"Real");
$f = Formula("$a/(t^$n)")->reduce;
($num,$den) = Fraction($a,$n-1)->value;
$F = FormulaUpToConstant("-$num/($den t^($n-1))")->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the indefinite integral. Don't forget your constant of integration!

[`\int [$f]\, dt`]

[_]{$F}{40}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
