$lb = random(2,9,1);
$ub = random(12,20,1);
$m = random(30,60,1);
$b = non_zero_random(-300,300,1);
if($envir{problemSeed}==1){$lb=7;$ub=14;$m=48;$b=-201;};
Context()->variables->are(i=>'Real');
$f = Formula("$m i + $b")->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
What is the upper bound in the summation [`\sum\limits_{i=[$lb]}^{[$ub]} ([$f])\text{?}`]

[_]{$ub}{10}

END_PGML

