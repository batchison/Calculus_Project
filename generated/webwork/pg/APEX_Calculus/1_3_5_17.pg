############################################################
# PG Setup Code
############################################################
$lb = 1;
($ub,$c) = random_subset(2,5..10);
if($envir{problemSeed}==1){$ub=10;$c=5;};
Context()->variables->are(i=>'Real');
$f = Formula("$c")->reduce;
@i = ($lb..$ub);
@fi = map{$f->eval(i=>$_)}(@i);
$string = join('+',@fi);
$sum = Real($string);

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the summation using Theorem[$NBSP]*1.3.7.

[`\sum\limits_{i=[$lb]}^{[$ub]} [$f]`]

[_]{$sum}{10}

END_PGML

############################################################
# End Problem
############################################################

