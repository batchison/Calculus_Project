loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "bizarroArithmetic.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$lb = random(2,5,1);
$ub = $lb + random(2,3,1);
if($envir{problemSeed}==1){$lb=2;$ub=4;};
@i = ($lb..$ub);
@fi = map{$_**2}(@i);
$string = join('+',@fi);
$sum = Real($string);
Context("Form");
Context()->operators->set(
  '+' => {class => 'bizarro::BOP::add', isCommand => 1},
  '-' => {class => 'bizarro::BOP::subtract', isCommand => 1},
);
$terms = Formula("$string");

############################################################
# Body
############################################################

BEGIN_PGML
Write out each term of the summation and compute the sum.

[`\sum\limits_{i=[$lb]}^{[$ub]} i^2`]

[@KeyboardInstructions('Enter the sum of terms here. For example, [|1+2+3|]*.')@]**

[_]{$terms}{20}

[@KeyboardInstructions('Enter the actual sum here.')@]**

[_]{$sum}{20}

END_PGML

############################################################
# End Problem
