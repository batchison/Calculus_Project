DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$b = list_random(-1,1);
$low = random(-4,-1,1);
($m,$n) = random_subset(2,3,5,7);
if($envir{problemSeed}==1){$b=-1;$low=-1;};
$high = -$low;
Context("Fraction");
Context()->noreduce('(-x)-y','(-x)+y');
$F = Formula("x^($m+1)/($m+1) + $b x^($n+1)/($n+1)")->reduce;
$f = Formula("x^($m) + $b x^($n)")->reduce;
$r = $F->eval(x=>$high) - $F->eval(x=>$low);

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} \left([$f]\right)\, dx`]

[_]{$r}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
