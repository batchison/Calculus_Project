$low = 1;
$high = random(2,9,1);
if($envir{problemSeed}==1){$high=2;};
$f = Formula("1/x^2")->reduce;
Context("Fraction");
$r = Fraction(1/$low - 1/$high);

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{[$low]}^{[$high]} [$f]\, dx`]

[_]{$r}{10}

END_PGML

