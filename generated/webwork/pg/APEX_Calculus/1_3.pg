DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
@a= random_subset(4,-9..9);
if($envir{problemSeed}==1){@a=(-6,6,9,0)};
$f=Formula("x^2-($a[1]+$a[2])x+$a[1]*$a[2]")->reduce;
$g=Formula("x^2-($a[1]+$a[3])x+$a[1]*$a[3]")->reduce;
$r=$f/$g;
Context("Fraction");
Context()->strings->add('does not exist'=>{alias=>'DNE'});
$L=Fraction($a[0]-$a[2],$a[0]-$a[3]);

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the limit.

[`\lim\limits_{x\to [$a[0]]}[$r]`]

[@KeyboardInstructions('If you need to enter [`\infty\text{,}`] you may type [|infinity|]*, or just [|INF|]*. If the limit does not exist, you may type [|does not exist|]*, or just [|DNE|]*.')@]**

[_]{$L}{20}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
