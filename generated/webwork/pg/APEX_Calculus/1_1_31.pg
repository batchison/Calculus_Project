Context('Numeric');
$a = random(2,9,1);
$b = random(2,9,1);
if($envir{problemSeed}==1){$a=5;$b=5;};
$f0 = $a+$b;
$f = Formula("$a e^x");
$F = Formula("$a e^x + $b");

############################################################
# Body
############################################################

BEGIN_PGML
Find the function determined by the given initial value problem.

[`\fp(x) = [$f]`] and [`f(0)= [$f0]`]

[_]{$F}{40}

END_PGML

