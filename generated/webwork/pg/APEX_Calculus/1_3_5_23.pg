############################################################
# PG Setup Code
############################################################
$lb = 1;
$ub = random(80,120,5);
if($envir{problemSeed}==1){$ub=100;};
Context()->variables->are(i=>'Real');
$f = Formula("i")->reduce;
@i = ($lb..$ub);
@fi = map{$f->eval(i=>$_)}(@i);
$string = join('+',@fi);
$sum = Real($string);
$penultimate = $ub - 1;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the summation using Theorem[$NBSP]*1.3.7.

[`1+2+3+\cdots+[$penultimate]+[$ub]`]

[_]{$sum}{10}

END_PGML

############################################################
# End Problem
############################################################

