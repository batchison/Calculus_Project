Context()->flags->set(reduceConstants=>0);
$a=random(1,9,1);
$n=random(1,4,1);
$trig=list_random('sin','cos','sec','csc','tan','cot');
($b,$c,$d)=num_sort(random_subset(3,2..9));
if($envir{problemSeed}==1){$a=2;$n=1;$trig='cot';$b=2;$c=3;$d=4;};
$f = Formula("$a x^$n e^x $trig(x)")->reduce;
$g = Formula("$b^x $c^x $d^x");
Context()->flags->set(reduceConstantFunctions=>0);
$fp=$f->D('x');
$gp=$g->D('x');

############################################################
# Body
############################################################

BEGIN_PGML
Find the derivatives of the following functions.

END_PGML

############################################################
# Scaffold
############################################################
Scaffold::Begin(numbered => 1,is_open => "correct_or_first_incorrect",can_open => always,);

############################################################
# Section
############################################################
Section::Begin("");

BEGIN_PGML
[`f(x) = [$f]`]

[_]{$fp}{40}

END_PGML

Section::End();

############################################################
