DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
($low,$high,$f) = random_subset(3,'e^','ln','sin','cos','sqrt');
if($envir{problemSeed}==1){$low='ln';$high='e^';$f='sin';};
Context()->variables->add(t=>'Real');
# interval where all these functions have positive output
Context()->variables->set(x=>{limits=>[1,pi/2]});
$low = Formula("$low(x)");
$high = Formula("$high(x)");
$f = Formula("$f(t)");
$D = $high->D('x') * $f->substitute(t=>$high) - $low->D('x') * $f->substitute(t=>$low);
$D = $D->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
Find [`F'(x)\text{.}`]

[`F(x) = \ds\int_{[$low]}^{[$high]} [$f]\, dt`]

[_]{$D}{30}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
