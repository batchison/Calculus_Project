Context('Numeric');
($a,$b) = random_subset(2,-9..-1,1..9);
if($envir{problemSeed}==1){$a=2;$b=-2;};
$f = Formula("$a cos(x) + $b sin(x)")->reduce;
$r = 2*$b;

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the definite integral.

[`\ds\int_{0}^{\pi} \left([$f]\right)\, dx`]

[_]{$r}{10}

END_PGML

