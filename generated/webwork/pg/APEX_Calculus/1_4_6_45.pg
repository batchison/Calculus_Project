DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "parserFormulaWithUnits.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$trig = list_random('sin','cos');
$lh = list_random(['0','pi/2'],['0','pi'],['0','3*pi/2'],['pi/2','pi'],['pi/2','3*pi/2'],['pi','3*pi/2']);
if($envir{problemSeed}==1){$trig='cos';$lh=['0','3*pi/2'];};
$low = Formula($lh->[0]);
$high = Formula($lh->[1]);
Context()->variables->are(t=>'Real');
$f = FormulaWithUnits("$trig(t) ft/s");
$F = Formula("-$trig(t)")->D('t')->reduce;
$D = FormulaWithUnits($F->eval(t=>Real("$high")) - $F->eval(t=>Real("$low")), 'ft');

############################################################
# Body
############################################################

BEGIN_PGML
A velocity function is given for an object moving along a straight line. Find the displacement of the object over the given time interval.

[`v(t)=[$f]`] on [`\left[[$low],[$high]\right]`]

[_]{$D}{10}

END_PGML

############################################################
# End Problem
############################################################

