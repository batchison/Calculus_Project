$a = random(2,9,1);
$n = random(2,9,1);
if($envir{problemSeed}==1){$a=3;$n=3};
$f = Formula("$a x^$n");
Context("Fraction");
$b = Fraction($a,$n+1);
$F = FormulaUpToConstant("$b x^($n+1)");

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the indefinite integral. Don't forget your constant of integration!

[`\int [$f]\, dx`]

[_]{$F}{40}

END_PGML

