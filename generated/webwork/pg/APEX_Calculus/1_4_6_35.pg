DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
Context('Numeric');
$trig = list_random('sin','cos');
$lh = list_random(['0','pi/2'],['0','pi'],['pi/2','pi']);
if($envir{problemSeed}==1){$trig='sin';$lh=['0','pi/2'];};
$low = Formula($lh->[0]);
$high = Formula($lh->[1]);
$D = $high - $low;
$f = Formula("$trig(x)");
$F = -$f->D('x')->reduce;
$A = ($F->eval(x=>Real("$high")) - $F->eval(x=>Real("$low")))/$D;
$num = Real($A*pi);
$A = Formula("$num/pi");

############################################################
# Body
############################################################

BEGIN_PGML
Find the average value of the function on the given interval.

[`f(x)=[$f]`] on [`\left[[$low],[$high]\right]`]

[_]{$A}{10}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
