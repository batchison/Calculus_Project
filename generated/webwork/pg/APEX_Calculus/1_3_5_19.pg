DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
$lb = 1;
$ub = random(8,12,1);
$a = random(2,6,1);
$b = non_zero_random(-4,4,1);
if($envir{problemSeed}==1){$ub=10;$a=3;$b=-2;};
Context()->variables->are(i=>'Real');
$f = Formula("$a i^2 + $b i")->reduce;
@i = ($lb..$ub);
@fi = map{$f->eval(i=>$_)}(@i);
$string = join('+',@fi);
$sum = Real($string);

############################################################
# Body
############################################################

BEGIN_PGML
Evaluate the summation using Theorem[$NBSP]*1.3.7.

[`\sum\limits_{i=[$lb]}^{[$ub]} \left([$f]\right)`]

[_]{$sum}{10}

END_PGML

############################################################
# End Problem
############################################################

