DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "contextForm.pl",
  "APEX.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################

############################################################
# PG Setup Code
############################################################
Context()->strings->add('does not exist'=>{alias=>'DNE'});
($a,$b,$c)=map{$_*random(-1,1,2)/10}random_subset(3,1..99);
if($envir{problemSeed}==1){$a=0.2;$b=-6;$c=4;};
$f=Formula("x^2-($a+$b)x+$a*$b")->reduce;
$g=Formula("x^2-($a+$c)x+$a*$c")->reduce;
$r=$f/$g;
$L=Real(($a-$b)/($a-$c));

############################################################
# Body
############################################################

BEGIN_PGML
Approximate the limit numerically.

[`\lim\limits_{x\to [$a]}[$r]`]

[@KeyboardInstructions('If you need to enter [`\infty\text{,}`] you may type [|infinity|]*, or just [|INF|]*. If the limit does not exist, you may type [|does not exist|]*, or just [|DNE|]*.')@]**

[_]{$L}{20}

END_PGML

############################################################
# End Problem
