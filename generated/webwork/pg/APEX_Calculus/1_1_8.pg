Context('Numeric');
parserFunction("F" => "exp(x)*sin(x)/sqrt(abs(x))");
parserFunction("G" => "ln(abs(x))*cos(x)*sqrt(abs(x))");
$answer = Formula('F(x)+G(x)');
$evaluator = $answer->cmp(upToConstant=>1);

############################################################
# Body
############################################################

BEGIN_PGML
If [`F(x)`] is an antiderivative of [`f(x)\text{,}`] and [`G(x)`] is an antiderivative of [`g(x)\text{,}`] give an antiderivative of [`f(x)+g(x)\text{.}`]

[_]{$evaluator}{20}

END_PGML

