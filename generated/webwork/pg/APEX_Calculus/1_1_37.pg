############################################################
# PG Setup Code
############################################################
Context('Numeric');
$fpp = random(2,9,1);
($fp0,$f0) = random_subset(2,-10..-2,2..10);
if($envir{problemSeed}==1){$fpp=5;$fp0=3;$f0=5;};
$f = Formula("$fpp e^x");
$F = Formula("$f + ($fp0-$fpp)x + ($f0-$fpp)")->reduce;

############################################################
# Body
############################################################

BEGIN_PGML
Find the function determined by the given initial value problem.

[`\fpp(x)=[$f]`] and [`\fp(0)=[$fp0]\text{,}`] [`f(0)=[$f0]`]

[_]{$F}{40}

END_PGML

############################################################
# End Problem
