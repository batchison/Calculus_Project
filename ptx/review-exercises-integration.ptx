          </pg-code>-->
          <statement>
            <p>
            Sketch a graph of the function <m>f(x)=\frac{1}{2}x-7</m>.  Use your graph to find <m>b</m> such that <m>\ds \int_{8}^{b}f(x)\, dx=0</m>.
            </p>
          </statement>
          <answer>
            <p>
            <m>14+2\sqrt{7}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
</exercisegroup>
