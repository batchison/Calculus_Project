<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="exercises-integration-review">
    <title>Review Exercises</title>
    
    <exercisegroup cols="2" xml:id="exset-indefinite-integral-review">
      <introduction>
        <p>
          Evaluate the given indefinite integral.
        </p>
      </introduction>

      <exercise label="ex-indefinite-integral-review-1">
        <webwork xml:id="webwork-ex-indefinite-integral-review-1">
          <pg-code>
            ($b,$c,$d) = random_subset(3,-9..-1,1..9);
            if($envir{problemSeed}==1){$b=-2;$c=7;$d=-9;};
            Context("Fraction");
            Context()->noreduce('(-x)+y');
            Context()->noreduce('(-x)-y');
            $f = Formula("x^3 + $b x^2 + $c x + $d")->reduce;
            $B = Fraction($b,3);
            $C = Fraction($c,2);
            $F = FormulaUpToConstant("1/4 x^4 + $B x^3 + $C x^2 + $d x");
          </pg-code>
          <statement>
            <p>
              <m>\ds \int \left(<var name="$f"/>\right)\, dx</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-indefinite-integral-review-2">
        <webwork xml:id="webwork-ex-indefinite-integral-review-2">
          <pg-code>
            ($s,$t,$u) = random_subset(3,'sin','cos','tan','sec','cot','csc');
            $a = list_random(-1,1);
            $b = list_random(-1,1);
            $c = list_random(-1,1);
            if($envir{problemSeed}==1){$s='cos';$c='sin';$d='tan';$a=-1;$b=-1;$c=1;};
            Context()->noreduce('(-x)+y');
            Context()->noreduce('(-x)-y');
            $F = Formula("$a $s(x) + $b $t(x) + $c $u(x)")->reduce;
            $f = $F->D('x')->reduce;
            $F = FormulaUpToConstant("$F");
          </pg-code>
          <statement>
            <p>
              <m>\ds \int \left(<var name="$f"/>\right)\, dx</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-indefinite-integral-review-3">
        <webwork xml:id="webwork-ex-indefinite-integral-review-3">
          <pg-code>
            $m = random(3,6,1);
            $n = random(2,8,1);
            $b = random(2,8,1);
            if($envir{problemSeed}==1){$m=3;$n=2;$b=2;};
            Context("Fraction");
            Context()->variables->add(t=>"Real");
            parser::Root->Enable;
            $f = Formula("root($m,t) + 1/t^$n + $b^t");
            $A = Fraction(1/(1/$m + 1));
            $M = Fraction(1/$m + 1);
            Context()->flags->set(reduceConstantFunctions=>0);
            $F = FormulaUpToConstant("$A*t^($M) - 1/(($n-1) t^($n-1)) + $b^t/ln($b)")->reduce;
          </pg-code>
          <statement>
            <p>
              <m>\ds \int \left(<var name="$f"/>\right)\, dt</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-indefinite-integral-review-4">
        <webwork xml:id="webwork-ex-indefinite-integral-review-4">
          <pg-code>
            $t = list_random('sec','csc','cot','tan');
            if($envir{problemSeed}==1){$t='csc';};
            $F = Formula("$t(x)");
            $f = Formula("1/x") + $F->D('x');
            $f = $f->reduce;
            $F = FormulaUpToConstant("ln(abs(x)) + $t(x)");
          </pg-code>
          <statement>
            <p>
              <m>\ds \int \left(<var name="$f"/>\right)\, dx</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>
    </exercisegroup>
    <exercisegroup cols="2">
      <introduction>
        <p>
          Find the general antiderivative of the given function.
        </p>
      </introduction>

      <exercise label="ex-antiderivative-review-1">
        <webwork xml:id="webwork-ex-antiderivative-review-1">
          <pg-code>
            $trig = list_random('tan','sec','csc','cot');
            $c = random(2,9,1);
            if($envir{problemSeed}==1){$trig='tan';$c=5;};
            $F = Formula("$c*$trig(x)");
            $f = $F->D('x')->reduce;
            $F = FormulaUpToConstant("$c*$trig(x)");
          </pg-code>
          <statement>
            <p>
              <m>f(x) = <var name="$f"/></m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-antiderivative-review-2">
        <webwork xml:id="webwork-ex-antiderivative-review-2">
          <pg-code>
            $c = random(2,9,1);
            if($envir{problemSeed}==1){$c=7;};
            $f = Formula("$c/x");
            $F = FormulaUpToConstant("$c*ln(abs(x))");
          </pg-code>
          <statement>
            <p>
              <m>f(x) = \ds <var name="$f"/></m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-antiderivative-review-3">
        <webwork xml:id="webwork-ex-antiderivative-review-3">
          <pg-code>
            ($a,$b,$c) = random_subset(3,-9..-1,1..9);
            ($m,$n,$p) = num_sort(random_subset(3,0..5));
            if($envir{problemSeed}==1){$a=4;$b=-5;$c=8;$m=5;$n=3;$p=0;};
            Context()->variables->add(t=>"Real");
            $f = Formula("$a t^$m + $b t^$n + $c t^$p")->reduce;
            Context("Fraction");
            Context()->variables->add(t=>"Real");
            $A = Fraction($a,$m+1);
            $B = Fraction($b,$n+1);
            $C = Fraction($c,$p+1);
            $F = FormulaUpToConstant("$A t^($m+1) + $B t^($n+1) + $C t^($p+1)")->reduce;
          </pg-code>
          <statement>
            <p>
              <m>g(t) = <var name="$f"/></m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-antiderivative-review-4">
        <webwork xml:id="webwork-ex-antiderivative-review-4">
          <pg-code>
            ($b,$c) = random_subset(2,2..9);
            if($envir{problemSeed}==1){$b=8;$c=5;};
            Context()->variables->add(t=>"Real");
            $f = Formula("$c $b^t")->reduce;
            Context()->flags->set(reduceConstantFunctions=>0);
            $F = FormulaUpToConstant("$c/ln($b) $b^t");
          </pg-code>
          <statement>
            <p>
              <m>g(t) = <var name="$f"/></m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-antiderivative-review-5">
        <webwork xml:id="webwork-ex-antiderivative-review-5">
          <pg-code>
            Context()->variables->add(t=>"Real");
            $F = FormulaUpToConstant("sin(t)-cos(t)");
          </pg-code>
          <statement>
            <p>
              <m>g(t) = \cos(t) + \sin(t)</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>

      <exercise label="ex-antiderivative-review-6">
        <webwork xml:id="webwork-ex-antiderivative-review-6">
          <pg-code>
            $F = FormulaUpToConstant("2*sqrt(x)");
          </pg-code>
          <statement>
            <p>
              <m>f(x) = \ds \frac{1}{\sqrt{x}}</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
        </webwork>
      </exercise>
      <exercise label="ex-antiderivative-review-7">
        <webwork xml:id="webwork-ex-antiderivative-review-7">
          <pg-code>
            $F = FormulaUpToConstant("tan^{-1}(x)");
          </pg-code>
          <statement>
            <p>
              <m>f(x) = \ds \frac{1}{1+x^2}</m>
            </p>
            <p>
              <var name="$F" width="40"/>
            </p>
          </statement>
<!--          <answer>
            <p>
            <m>\tan^{-1}(x)+C
            </m>
            </p>
          </answer>-->
        </webwork>
      </exercise>
    </exercisegroup>

    <exercisegroup cols="2">
      <introduction>
        <p>
          Use one or more familiar properties from algebra or precalculus to rewrite and evaluate the given indefinite integral.
        </p>
      </introduction>
      <exercise label="ex-indefinite-integral-review-5">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int \left(2-x(x-6)\right)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>-\frac{x^3}{3}+3x^2+2x+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-6">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int (x-3)(2+x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{x^3}{3}-\frac{x^2}{2}-6x+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-7">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-7">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int \sqrt[3]{8x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{3}{2}x^{\frac{4}{3}}+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-8">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-8">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int \frac{10}{\sqrt{5x}}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>4\sqrt{5x}+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-9">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-9">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int (x+1)^3\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{x^4}{4}+x^3+\frac{3x^2}{2}+x+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-10">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-10">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int (2x+1)^3\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>2x^4+4x^3+3x^2+x+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-11">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-11">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int \frac{x^2-9}{x}\, dx, \ x\neq 0</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{x^2}{2}-9\ln|x|+C
            </m>
            </p>
          </answer>
<!--        </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-integral-review-12">
<!--        <webwork xml:id="webwork-ex-indefinite-integral-review-12">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int \frac{x^2-5x+6}{x-2}\, dx, \ x\neq 2</m>
            </p>
          </statement>
          <answer>
