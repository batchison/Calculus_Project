          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            Consider the function below.
            <md>f(x) = \begin{cases} 
			x-5 \amp 0\leq x &lt; 5\\
			k \amp 5\leq x 
			\end{cases}</md>
            </p>
            <p>Find <m>k</m> such that <m>\ds \int_{0}^{10}f(x)\, dx=25</m>.
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{15}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-definite-integral-find-value-2">
<!--    <webwork xml:id="webwork-ex-definite-integral-find-value-2">
