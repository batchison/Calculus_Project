<exercisegroup xml:id="exset-initial-value-review">
      <introduction>
        <p>
        Find the function <m>f</m> described by the given initial value problem.
        </p>
      </introduction>
      <exercise label="ex-initial-value-review-1">
<!--    <webwork xml:id="webwork-ex-initial-value-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f'(x)=\ds \frac{1}{2\sqrt{x}}</m> and <m>f(1)=0</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>f(x)=\sqrt{x}-1</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-initial-value-review-2">
<!--    <webwork xml:id="webwork-ex-initial-value-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f'(\theta)=\sec(\theta)\tan(\theta)</m> and <m>f(\frac{\pi}{3})=-2</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>f(\theta)=\sec(\theta)-4</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-initial-value-review-3">
<!--    <webwork xml:id="webwork-ex-initial-value-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f''(\theta)=-\cos(\theta)\ds </m> and <m>f'(\pi)=\frac{1}{2}</m>, <m>f(\pi)=\pi-1</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>f(\theta)=\cos(\theta)+\frac{1}{2}\theta+\frac{\pi}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-initial-value-review-4">
<!--    <webwork xml:id="webwork-ex-initial-value-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f''(x)=\ds \frac{x^3}{3}-\frac{x}{2}</m> and <m>f'(-1)=\frac{1}{3}</m>, <m>f(-1)=\frac{2}{5}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>f(x)=\ds \frac{x^5}{60}-\frac{x^3}{12}+\frac{x}{2}+\frac{5}{6}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
<exercisegroup cols="2" xml:id="exset-definite-integral-review">
      <introduction>
        <p>
          Sketch the graph of the given function <m>f(x)</m> over the specified interval, <m>[a,b]</m>.  Then, using the geometry of the graph, evaluate the definite integral <m>\int_{a}^{b} f(x)\, dx</m>.
        </p>
      </introduction>
      <exercise label="ex-definite-integral-review-1">
<!--    <webwork xml:id="webwork-ex-definite-integral-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f(x)=x+5</m> over <m>[0,5]</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{75}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-definite-integral-review-2">
<!--    <webwork xml:id="webwork-ex-definite-integral-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f(x)=|x-3|-1</m> over <m>[-1,6]</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{11}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
