      <exercisegroup cols="2" xml:id="exset-FTC-I">
      <introduction>
        <p>Find <m>F'(x)</m>.
        </p>
      </introduction>
      <exercise label="ex-FTC-I-1">
<!--    <webwork xml:id="webwork-ex-FTC-I-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds F(x)=\int_{2}^{x}\left(e^t+\frac{1}{t}\right)\, dt</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>F'(x)=e^x+\frac{1}{x}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-FTC-I-2">
<!--    <webwork xml:id="webwork-ex-FTC-I-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds F(x)=\int_{0}^{\sqrt{x}}\sin(t)\, dt</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>F'(x)=\frac{\sin(\sqrt{x})}{2\sqrt{x}}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-FTC-I-3">
<!--    <webwork xml:id="webwork-ex-FTC-I-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds F(x)=\int_{e^x}^{0}t^2\, dt</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>F'(x)=-e^{3x}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-FTC-I-4">
<!--    <webwork xml:id="webwork-ex-FTC-I-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds F(x)=\int_{2x}^{x^2}\frac{dt}{t}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>F'(x)=\frac{1}{x}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      </exercisegroup>      
      <exercisegroup cols="2" xml:id="exset-FTC-II">
      <introduction>
        <p>Evaluate the definite integral.
        </p>
      </introduction>
      <exercise label="ex-FTC-II-1">
