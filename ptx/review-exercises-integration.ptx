<exercisegroup xml:id="exset-area-between-curves">
      <introduction>
        <p>Sketch the given relations and find the area of the enclosed region(s).
        </p>
      </introduction>
      <exercise label="ex-area-between-curves-1">
<!--    <webwork xml:id="webwork-ex-area-between-curves-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>y=-x^2+x+6</m> and <m>y=x^2-x+2</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>9</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-area-between-curves-2">
<!--    <webwork xml:id="webwork-ex-area-between-curves-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>y=-x^3+12x</m> and <m>y=3x</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{81}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-area-between-curves-3">
<!--    <webwork xml:id="webwork-ex-area-between-curves-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>y=x^2+5x+6</m> and <m>y=-x^2-4x+2</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{7}{24}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-area-between-curves-4">
<!--    <webwork xml:id="webwork-ex-area-between-curves-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>x=y^2-6y+10</m> and <m>x=6-y</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{9}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-area-between-curves-5">
<!--    <webwork xml:id="webwork-ex-area-between-curves-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>y=2\sqrt{x}</m>, <m>y=-x+3</m>, and <m>y=0</m> 
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{10}{3}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-area-between-curves-6">
<!--    <webwork xml:id="webwork-ex-area-between-curves-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>y=\sqrt{4-x}</m>, <m>y=x-2</m>, and <m>y=0</m> 
            </p>
          </statement>
          <answer>
            <p>
            <m>\frac{7}{6}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
  </exercisegroup>
<exercisegroup cols="2" xml:id="exset-mvt-review">
      <introduction>
        <p>Find a value <m>c</m> guaranteed by the Mean Value Theorem.
        </p>
      </introduction>
      <exercise label="ex-mvt-review-1">
<!--    <webwork xml:id="webwork-ex-mvt-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds \int_{1}^{10}\left(\frac{4-x}{3}\right)\,dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>c=\frac{11}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-mvt-review-2">
<!--    <webwork xml:id="webwork-ex-mvt-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds \int_{1}^{3} \frac{5}{x}\,dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>c=\frac{2}{\ln 3}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-mvt-review-3">
<!--    <webwork xml:id="webwork-ex-mvt-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \int_{-8}^{0} \sqrt[3]{x}\,dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>c=-\frac{27}{8}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-mvt-review-4">
<!--    <webwork xml:id="webwork-ex-mvt-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds \int_{0}^{1} \frac{dx}{1+x^2}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>c=\sqrt{\frac{4-\pi}{\pi}}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
      <exercisegroup xml:id="exset-definite-integrals-abs-value">
      <introduction>
        <p>For each item, identify a function <m>f(x)</m> and an interval <m>[a,b]</m> that satisfy the given statement.
        </p>
      </introduction>
      <exercise label="ex-definite-integrals-abs-value-1">
<!--    <webwork xml:id="webwork-ex-definite-integrals-abs-value-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds \left|\int_a^b f(x)\,dx\right|=\int_a^b |f(x)|\,dx</m>
            </p>
          </statement>
          <answer>
            <p>
            Any function <m>f</m> such that <m>f\geq 0</m> over <m>[a,b]</m> will work.
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-definite-integrals-abs-value-2">
<!--    <webwork xml:id="webwork-ex-definite-integrals-abs-value-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            <m>\ds \left|\int_a^b f(x)\,dx\right| &lt; \int_a^b |f(x)|\,dx</m>
            </p>
          </statement>
          <answer>
            <p>
            Any function <m>f</m> such that <m>f &lt; 0</m> over some subinterval of <m>[a,b]</m> will work.  For example, <m>f(x)=x^2-1</m> over <m>[0,2]</m>.
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>

<exercisegroup cols="2" xml:id="exset-definite-integrals-graph">
      <introduction>
        <p>Use the graph pictured below to determine the area of the specified region.
        </p>
      <image width="75%">
                  <shortdescription>
                    Graph of sine and cosine curves over the interval from zero to one half pi.
                    </shortdescription>
                    <description>
                    <p>
                    The <m>y</m> axis is drawn from <m>0</m> to <m>1.5</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>2</m>.
                    The graphs of two curves are drawn in the first quadrant.  One curve is the function <m>y=\cos(x)</m>, from <m>x=0</m> to <m>x=\frac{\pi}{2}</m>.  The second curve is the function <m>y=\sin(x)</m>, from <m>x=0</m> to <m>x=\frac{\pi}{2}</m>.
                    </p>
                    </description>

                <latex-image label="img_05_rev_image_01">
                    \begin{tikzpicture}
                      \begin{axis}[
                          axis on top,
                          xtick={1},
                          ytick={1},
                          ymin=0,
                          ymax=2,
                          xmin=0,
                          xmax=2
                        ]
                        \addplot [secondcurvestyle,areastyle,domain=0:1.57076] {cos(deg(x))} \closedcycle;
                        \addplot [firstcurvestyle,areastyle,domain=0:0.785398] {sin(deg(x))} \closedcycle;
                        \addplot [firstcurvestyle,areastyle,domain=0.785398:1.57076] {cos(deg(x))} \closedcycle;
                        \addplot [secondcurvestyle,areastyle,domain=0:1.57076] {cos(deg(x))} \closedcycle;
                        \addplot [firstcolor,domain=0:1.57076,samples=50] {sin(deg(x))};
                        \addplot [secondcolor,domain=0:1.57076,samples=50] {cos(deg(x))};
                        \draw (axis cs:1.7,1.15) node { \(y=\sin(x)\)};
                        \draw (axis cs:1.7,0.25) node { \(y=\cos(x)\)};
                        \draw (axis cs:.3,.65) node { \(A\)};
                        \draw (axis cs:.785,.35) node { \(B\)};
                      \end{axis}
                    \end{tikzpicture}
                </latex-image>
                </image>
                </introduction>
      <exercise label="ex-definite-integrals-graph-1">
<!--    <webwork xml:id="webwork-ex-definite-integrals-graph-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            Region <m>A</m>
            </p>
          </statement>
          <answer>
            <p><m>\sqrt{2}-1</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
     <exercise label="ex-definite-integrals-graph-2">
<!--    <webwork xml:id="webwork-ex-definite-integrals-graph-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>  
            Region <m>B</m>
            </p>
          </statement>
          <answer>
            <p><m>2-\sqrt{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
  </exercises>
