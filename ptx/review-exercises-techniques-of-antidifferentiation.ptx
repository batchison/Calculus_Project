<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="exercises-techniques-of-antidifferentiation-review">
    <title>Review Exercises</title>
    
<exercisegroup cols="2" xml:id="exset-indefinite-int-review">
      <introduction>
        <p>
        Evaluate the indefinite integral.
        </p>
      </introduction>
      <exercise label="ex-indefinite-int-review-1">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}(2-x)^3\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -\frac{(2-x)^4}{4}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-2">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\sqrt{1+2x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{3}(1+2x)^{\frac{3}{2}}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-3">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}4\cos(\theta)\sin(\theta)\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 2\sin^2(\theta)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-4">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{e^{\sqrt{x}}}{\sqrt{x}}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 2e^{\sqrt{x}}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-5">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\sin(1-\theta)\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \cos(1-\theta)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-6">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}12x(3x^2+2)^2\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{2}{3}(3x^2+2)^3+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-7">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-7">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{\sin(\ln(x))}{x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -\cos(\ln(x))+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-8">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-8">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\cot(\theta)\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln(|\sin(\theta)|)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-9">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-9">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\, \frac{2x+3}{x^2+1}\,dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln(x^2+1)+3\tan^{-1}(x)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-10">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-10">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{2x^2+1}{x^2+1}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 2x-\tan^{-1}(x)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-11">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-11">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{x}{\sqrt{x^2+9}}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sqrt{x^2+9}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-12">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-12">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{x-1}{x+1}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds x-2\ln(|x+1|)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-13">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-13">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{dx}{1-2x}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -\frac{1}{2}\ln(|1-2x|)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-14">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-14">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{2x}{1-2x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -x-\frac{1}{2}\ln(|1-2x|)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-15">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-15">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}x(1-x)^4\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{(1-x)^6}{6}-\frac{3(1-x)^5}{5}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-16">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-16">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{x}{(x-2)^3}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1-x}{(x-2)^2}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-17">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-17">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}x\sqrt{1+x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{2}{5}(1+x)^{\frac{5}{2}}-\frac{2}{3}(1+x)^{\frac{3}{2}}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-18">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-18">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}4x^3(3+x^2)^5\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{2}{7}(3+x^2)^7-(3+x^2)^6+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-19">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-19">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{10}{4x^2+1}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 5\tan^{-1}(2x)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-20">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-20">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{dx}{3+x^2}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{\sqrt{3}}{3}\tan^{-1}\left(\frac{\sqrt{3}}{3}x\right)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-21">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-21">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{dx}{4+9x^2}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{6}\tan^{-1}\left(\frac{3}{2}x\right)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-22">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-22">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}6x(1-4x^2)^5\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -\frac{(1-4x^2)^6}{8}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-23">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-23">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}x^2e^x\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds e^{x}(x^2-2x+2)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-24">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-24">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{x^2}{e^x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -\frac{1}{e^{x}}(x^2+2x+2)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-25">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-25">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\frac{\ln(x)}{x^2}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -\frac{1}{x}\left(\ln(x)+1\right)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-26">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-26">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}x^2\ln\left(x^2\right)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{2x^3}{3}\left(\ln(x)-\frac{1}{3}\right)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-27">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-27">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}\sqrt{x}\ln\left(2x\right)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{2}{3}x^{\frac{3}{2}}\left(\ln(2x)-\frac{2}{3}\right)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-indefinite-int-review-28">
<!--    <webwork xml:id="webwork-ex-indefinite-int-review-28">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}2x\tan^{-1}\left(\frac{x}{2}\right)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds (x^2+4)\tan^{-1}\left(\frac{x}{2}\right)-2x+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      </exercisegroup>
<exercisegroup cols="2" xml:id="exset-definite-int-review">
      <introduction>
        <p>
        Evaluate the definite integral.
        </p>
      </introduction>
      <exercise label="ex-definite-int-review-1">
<!--    <webwork xml:id="webwork-ex-definite-int-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{2}^{e+1}\frac{1}{1-x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -1</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-definite-int-review-2">
<!--    <webwork xml:id="webwork-ex-definite-int-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{\frac{\pi}{6}}^{\frac{\pi}{3}}\sin\left(2\theta\right)\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-3">
<!--    <webwork xml:id="webwork-ex-definite-int-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{\pi}^{3\pi}\cos\left(\frac{\theta}{6}\right)\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 3</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-4">
<!--    <webwork xml:id="webwork-ex-definite-int-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{-1}^{1}\, \frac{2}{2-x}dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln(9)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-5">
<!--    <webwork xml:id="webwork-ex-definite-int-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{2}^{4}(3-x)^4\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{2}{5}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-6">
<!--    <webwork xml:id="webwork-ex-definite-int-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{\frac{\pi}{4}}^{\frac{\pi}{3}}\tan(\theta)\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{2}\ln(2)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-7">
<!--    <webwork xml:id="webwork-ex-definite-int-review-7">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{\frac{2}{3}}^{1}e^{2-3x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{3}\left(1-\frac{1}{e}\right)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-8">
<!--    <webwork xml:id="webwork-ex-definite-int-review-8">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{\ln(9)}\sqrt{e^x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 4</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-9">
<!--    <webwork xml:id="webwork-ex-definite-int-review-9">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{\frac{\pi}{2}}\frac{\sin(\theta)}{1+\cos(\theta)}\, d\theta</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln(2)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-10">
<!--    <webwork xml:id="webwork-ex-definite-int-review-10">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{1}^{3}\frac{2}{(1-2x)^2}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{4}{5}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-11">
<!--    <webwork xml:id="webwork-ex-definite-int-review-11">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{e}^{e^{2}}\frac{dx}{x\ln(x)}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln(2)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-12">
<!--    <webwork xml:id="webwork-ex-definite-int-review-12">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{6}^{12}\frac{x}{x-3}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 3(2+\ln(3))</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-13">
<!--    <webwork xml:id="webwork-ex-definite-int-review-13">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{4}\frac{2x}{4+x^2}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln(5)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-14">
<!--    <webwork xml:id="webwork-ex-definite-int-review-14">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{3}\frac{x}{\sqrt{x+1}}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{8}{3}</m>
            </p>
          </answer>
<!--    </webwork>-->
