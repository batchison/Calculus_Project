            <exercise label="ex-definite-int-review-18">
<!--    <webwork xml:id="webwork-ex-definite-int-review-18">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{\pi}x\cos(x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds -2</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-19">
<!--    <webwork xml:id="webwork-ex-definite-int-review-19">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{e}^{e^{2}}\ln(x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds e^{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-20">
<!--    <webwork xml:id="webwork-ex-definite-int-review-20">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{1}\tan^{-1}(x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{2}\left(\frac{\pi}{2}-\ln(2)\right)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
            <exercise label="ex-definite-int-review-21">
<!--    <webwork xml:id="webwork-ex-definite-int-review-21">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{\frac{1}{2}}x^2e^{2x}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{4}\left(\frac{e}{2}-1\right)</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
<exercisegroup xml:id="exset-substitution-area-review">
      <introduction>
        <p>
        Sketch the given relations and find the area of the enclosed region.
        </p>
      </introduction>
      <exercise label="ex-substitution-area-review-1">
<!--    <webwork xml:id="webwork-ex-substitution-area-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds y=e^{3x}, y=2x^2, x=0,</m> and <m>x=1</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{3}e^{3}-1</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-substitution-area-review-2">
<!--    <webwork xml:id="webwork-ex-substitution-area-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds y=\frac{x}{3}+1</m> and <m>y=(x+1)^2</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{125}{162}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-substitution-area-review-3">
<!--    <webwork xml:id="webwork-ex-substitution-area-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds y=\frac{1}{(x+1)^2}, y=\frac{x}{4},</m> and <m>x=0</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{3}{8}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
  </exercisegroup>
      <exercise label="ex-substitution-area-review-4">
<!--    <webwork xml:id="webwork-ex-substitution-area-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
        <p>
        Find the area of the enclosed region.
        </p>
                  <image width="67%">
                  <shortdescription>
                    Graph of two intersecting curves over the interval from one to two.
                    </shortdescription>
                    <description>
                    <p>
                    The <m>y</m> axis is drawn from <m>0</m> to <m>2</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>2.5</m>.
                    The graphs of two curves are drawn in the first quadrant.  One curve is the function <m>\ds y=\frac{3x}{2+x^2}</m>, from <m>x=1</m> to <m>x=2</m>.  The second curve is the function <m>y=2x^2-6x+5</m>, from <m>x=0</m> to <m>x=2</m>.
                    </p>
                    </description>

                <latex-image label="img_06_rev_image_01">
                    \begin{tikzpicture}
                      \begin{axis}[
                          axis on top,
                          xtick={1,2},
                          ytick={1},
                          ymin=0,
                          ymax=2,
                          xmin=0,
                          xmax=2.5,
                          xmajorgrids,
                          ymajorgrids
                        ]
                        \addplot [name path=A,firstcurvestyle,domain=0.9:2.1,samples=50] {2*x^2-6*x+5} node [shift={(-50pt,-75pt)} ,black] { \(y=2x^2-6x+5\)};
                        \addplot [name path=B,firstcurvestyle,domain=0.9:2.1] {3*x/(2+x^2)} node [shift={(-50pt,40pt)} ,black] { \(y=\ds \frac{3x}{2+x^2}\)};
                        \addplot [firstcurvestyle,areastyle] fill between [of=A and B,soft clip={domain=1:2}];
                        \end{axis}
                    \end{tikzpicture}
                </latex-image>
                </image>
<!--            <p>
              <m>\ds y=\frac{3x}{2+x^2}</m> and <m>y=2x^2-6x+5</m>
            </p>-->
          </statement>
          <answer>
            <p>
            <m>\ds \frac{3}{2}\ln(2)-\frac{2}{3}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-initial-value-subs-1">
<!--    <webwork xml:id="webwork-ex-initial-value-subs-1">
          <pg-code>
          </pg-code>-->
          <statement>
        <p>
        Find the function <m>f</m> described by the given initial value problem.
        </p>
            <p>
              <m>\fp(x)=\ds x\sqrt{x-3}</m> and <m>f(4)=4</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds f(x)=\frac{2}{5}(x-3)^{\frac{5}{2}}+2(x-3)^{\frac{3}{2}}+\frac{8}{5}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-substitution-find-k">
<!--    <webwork xml:id="webwork-ex-substitution-find-k">
          <pg-code>
          </pg-code>-->
          <statement>
        <p> Prove the following identity, where <m>m,b,</m> and <m>k</m> are constants with <m>m\neq 0</m> and <m>k&gt; 0</m>.</p>
            <p>
              <m>\ds \int(mx+b)^k\, dx=\frac{(mx+b)^{k+1}}{mk+m}+C</m>
            </p>
        <p>Use the given identity to evaluate the following integral.</p>
        <p><m>\ds \int\left(\frac{3-x}{2}\right)^3\, dx</m></p>
          </statement>
          <answer>
            <p><m>\ds -\frac{(x-3)^4}{32}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    
<exercisegroup xml:id="exset-int-by-parts-formulas">
      <introduction>
        <p>
        Evaluate the indefinite integral for <m>k\neq 0</m>.
        </p>
      </introduction>
      <exercise label="ex-int-by-parts-formulas-1">
<!--    <webwork xml:id="webwork-ex-int-by-parts-formulas-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}xe^{kx}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{e^{kx}}{k}\left(x-\frac{1}{k}\right)+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-int-by-parts-formulas-2">
<!--    <webwork xml:id="webwork-ex-int-by-parts-formulas-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}e^{kx}\sin(x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{e^{kx}(k\sin(x)-\cos(x))}{1+k^2}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-int-by-parts-formulas-3">
<!--    <webwork xml:id="webwork-ex-int-by-parts-formulas-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{}^{}e^{kx}\cos(x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{e^{kx}(k\cos(x)+\sin(x))}{1+k^2}+C</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      </exercisegroup>

    </exercises>
