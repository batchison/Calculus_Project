      </exercise>
            <exercise label="ex-definite-int-review-17">
<!--    <webwork xml:id="webwork-ex-definite-int-review-17">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{-\frac{\pi}{2}}^{\frac{\pi}{2}}x\sin(x)\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds 2</m>
            </p>
          </answer>
<!--    </webwork>-->
