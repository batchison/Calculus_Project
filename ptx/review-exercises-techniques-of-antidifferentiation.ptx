<exercises xml:id="exercises-techniques-of-antidifferentiation-review">
    <title>Review Exercises</title>
    
<exercisegroup cols="2" xml:id="exset-integration-review">
      <introduction>
        <p>
        Evaluate the indefinite integral.
        </p>
      </introduction>
      <exercise label="ex-integration-review-1">
<!--    <webwork xml:id="webwork-ex-integration-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>f'(x)=\ds \frac{1}{2\sqrt{x}}</m> and <m>f(1)=0</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>f(x)=\sqrt{x}-1</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
