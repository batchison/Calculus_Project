            <exercise label="ex-definite-int-review-15">
<!--    <webwork xml:id="webwork-ex-definite-int-review-15">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{1}\frac{1}{4x^2+4x+1}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \frac{1}{3}</m>
            </p>
          </answer>
