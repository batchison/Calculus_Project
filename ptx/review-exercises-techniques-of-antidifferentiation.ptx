      </exercise>
            <exercise label="ex-definite-int-review-16">
<!--    <webwork xml:id="webwork-ex-definite-int-review-16">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
              <m>\ds \int_{0}^{\ln(2)}\frac{e^{x}}{e^{x}+4}\, dx</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \ln\left(\frac{6}{5}\right)</m>
            </p>
          </answer>
