<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="exercises-applications-of-integration-review">
    <title>Review Exercises</title>
    
<exercisegroup cols="2" xml:id="exset-volume-review">
  <introduction>
    <p>Use either the Disk/Washer Method or the Shell Method to find the volume of the solid of revolution formed by revolving the shaded region about each of the given axes.
    </p>
  </introduction>
  <exercise label="ex-volume-review-1">
<!--    <webwork xml:id="webwork-ex-volume-review-1">
          <pg-code>
          </pg-code>-->
      <introduction>
      <image width="100%">
        <shortdescription> Graph of sine curve over the interval from zero to pi.
        </shortdescription>
        <description>
        <p>The <m>y</m> axis is drawn from <m>0</m> to <m>1.5</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>\frac{3\pi}{2}</m>.The graph is drawn in the first quadrant. The curve is the function <m>\ds y=\sin(x)</m>, from <m>x=0</m> to <m>\ds x=\pi</m>.
        </p>
        </description>
        <latex-image label="img_07_rev_image_01">
          \begin{tikzpicture}
          \begin{axis}[axis on top,xtick={(pi)/4,(pi)/2,(3*pi)/4,pi,(5*pi)/4},xticklabels={$\frac{\pi}{4}$,$\frac{\pi}{2}$,$\frac{3\pi}{4}$,$\pi$,$\frac{5\pi}{4}$},ytick={0.5,1},yticklabels={$\frac{1}{2}$,$1$},ymin=0,ymax=1.5,xmin=0,xmax=(3*pi)/2]
            \addplot [name path=A,firstcurvestyle,domain=0:pi,samples=100] {sin(deg(x))};
            \addplot [firstcurvestyle,areastyle,domain=0:pi] {sin(deg(x))} \closedcycle;
            \draw (axis cs:1.7,1.15) node {\(y=\sin(x)\)};
          \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
      </introduction>
      <task label="ex-volume-review-1a">
        <statement>
        <p>
        Rotate about the <m>x</m> axis.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi^2}{2}</m>
        </p>
        </answer>
      </task>
      <task label="ex-volume-review-1b">
        <statement>
        <p>
        Rotate about the <m>y</m> axis.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds 2\pi^2</m>
        </p>
        </answer>
      </task>
      <task label="ex-volume-review-1c">
        <statement>
        <p>
        Rotate about <m>y=1</m>.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi}{2}(8-\pi)</m>
        </p>
        </answer>
      </task>
<!--    </webwork>-->
  </exercise>
  <exercise label="ex-volume-review-2">
<!--    <webwork xml:id="webwork-ex-volume-review-2">
          <pg-code>
          </pg-code>-->
      <introduction>
      <image width="100%">
        <shortdescription>Graph of intersecting parabolas over the interval from one to five.
        </shortdescription>
        <description>
        <p>The <m>y</m> axis is drawn from <m>0</m> to <m>10</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>6</m>.The graphs of two curves are drawn in the first quadrant.  One curve is the function <m>\ds f(x)=-\frac{1}{2}(x-3)^2+7</m>, from <m>x=0</m> to <m>6</m>.  The second curve is the function <m>\ds g(x)=(x-3)^2+1</m>, from <m>x=0</m> to <m>6</m>.
        </p>
        </description>
        <latex-image label="img_07_rev_image_02">
          \begin{tikzpicture}
          \begin{axis}[axis on top,xtick={1},ytick={1},ymin=0,ymax=10,xmin=0,xmax=6]
            \addplot [name path=A,firstcurvestyle,domain=0:6,samples=100] {-1/2*(x-3)^2+7};
            \addplot [name path=B,firstcurvestyle,domain=0:6,samples=100] {(x-3)^2+1};
            \addplot [firstcurvestyle,areastyle] fill between [of=A and B,soft clip={domain=1:5}];
            \draw (axis cs:2,9) node { \(f(x)=-\frac{1}{2}(x-3)^2+7\)};
            \draw (axis cs:2,1) node { \(g(x)=(x-3)^2+1\)};
          \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
      </introduction>
    <task label="ex-volume-review-2a">
        <statement>
        <p>
        Rotate about the <m>x</m> axis.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi^2}{2}</m>
        </p>
        </answer>
      </task>
      <task label="ex-volume-review-2b">
        <statement>
        <p>
        Rotate about the <m>y</m> axis.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds 2\pi^2</m>
        </p>
        </answer>
      </task>
      <task label="ex-volume-review-2c">
        <statement>
        <p>
        Rotate about <m>y=1</m>.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi}{2}(8-\pi)</m>
        </p>
        </answer>
      </task>
<!--    </webwork>-->
  </exercise>
</exercisegroup>
</exercises>
