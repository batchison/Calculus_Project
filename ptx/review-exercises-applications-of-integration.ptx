      <introduction>
      <image width="75%">
        <shortdescription>Graph of intersecting sideways parabolas over the interval for y-coordinates from two to six.
        </shortdescription>
        <description>
        <p>The <m>y</m> axis is drawn from <m>0</m> to <m>7</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>11</m>.  The graphs of two curves are drawn in the first quadrant.  One curve is the function <m>\ds f(y)=\frac{1}{2}(y-2)^2+2</m>, from <m>x=2</m> to <m>11</m>.  The second curve is the function <m>\ds g(y)=(y-3)^2+1</m>, from <m>x=1</m> to <m>11</m>.  The shaded region is bounded by the two curves.
        </p>
        </description>
        <latex-image label="img_07_rev_image_07">
          \begin{tikzpicture}
          \begin{axis}[axis on top,xtick={2,4,6,8,10},ytick={2,4,6},ymin=0,ymax=7,xmin=0,xmax=11]
            \addplot [name path=AU,firstcurvestyle,domain=1:11,samples=200] {((x-1)^0.5)+3};
            \addplot [name path=AL,firstcurvestyle,domain=1:2.5,samples=200] {(-(x-1)^0.5)+3};
            \addplot [name path=BU,firstcurvestyle,secondcolor,domain=2:11,samples=200] {(2^0.5*(x-2)^0.5)+2};
            \addplot [name path=BL,firstcurvestyle,secondcolor,domain=2:2.5,samples=200] {(-2^0.5*(x-2)^0.5)+2};
            \addplot [firstcurvestyle,areastyle] fill between [of=AU and AL,soft clip={domain=1:2}];
            \addplot [firstcurvestyle,areastyle] fill between [of=AU and BU,soft clip={domain=2:10}];
            \draw (axis cs:6,3) node { \(f(y)=\frac{1}{2}(y-2)^2+1\)};
            \draw (axis cs:4,6) node { \(g(y)=(y-3)^2+1\)};
          \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
      </introduction>
    <task label="ex-volume-review-7a">
        <statement>
        <p>
        Rotate about the <m>y</m> axis.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi^2}{2}</m>
        </p>
        </answer>
      </task>
    <task label="ex-volume-review-7b">
        <statement>
        <p>
        Rotate about the <m>x</m> axis.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi^2}{2}</m>
        </p>
        </answer>
      </task>
<!--  </webwork>-->
  </exercise>
  <exercise label="ex-volume-review-8">
<!--    <webwork xml:id="webwork-ex-volume-review-8">
          <pg-code>
          </pg-code>-->
      <introduction>
      <image width="75%">
        <shortdescription>Graph of line and semicircle in first quadrant.
        </shortdescription>
        <description>
        <p>The <m>y</m> axis is drawn from <m>0</m> to <m>9</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>4.5</m>.  The graphs of two curves are drawn in the first quadrant.  One curve is <m>\ds y=-2x+8</m>, from <m>x=0</m> to <m>4</m>.  The second curve is <m>y=\sqrt{4-x^2}</m>, from <m>x=0</m> to <m>2</m>.  The shaded region is bounded by the two curves and both the <m>x</m> and <m>y</m> axes.
        </p>
        </description>
        <latex-image label="img_07_rev_image_08">
          \begin{tikzpicture}
          \begin{axis}[axis on top,xtick={1,2,3,4},ytick={2,4,6,8},ymin=0,ymax=9,xmin=0,xmax=4.5]
            \addplot [name path=A,firstcurvestyle,domain=0:4,samples=100] {-2*x+8};
            \addplot [name path=B,firstcurvestyle,secondcolor,domain=0:2,samples=100] {(4-x^2)^0.5};
            \addplot [firstcurvestyle,areastyle] fill between [of=A and B,soft clip={domain=0:2}];
            \addplot [firstcurvestyle,areastyle,domain=2:4] {-2*x+8} \closedcycle;
            \draw (axis cs:2,7) node { \(y=-2x+8\)};
            \draw (axis cs:1,2.5) node { \(y=\sqrt{4-x^2}\)};
          \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
      </introduction>
    <task label="ex-volume-review-8a">
        <statement>
        <p>
        Rotate about the <m>y</m> axis.  Evaluate.
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi^2}{2}</m>
        </p>
        </answer>
      </task>
    <task label="ex-volume-review-8b">
        <statement>
        <p>
        Rotate about the <m>x</m> axis.  Evaluate
        </p>
        </statement>
        <answer>
        <p>
        <m>\ds \frac{\pi^2}{2}</m>
        </p>
        </answer>
      </task>
<!--  </webwork>-->
  </exercise>
