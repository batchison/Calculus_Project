  <exercise label="ex-volume-review-5">
<!--    <webwork xml:id="webwork-ex-volume-review-5">
          <pg-code>
          </pg-code>-->
      <introduction>
      <image width="75%">
        <shortdescription> Graph of a triangular region in first quadrant.
        </shortdescription>
        <description>
        <p>The <m>y</m> axis is drawn from <m>0</m> to <m>5.5</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>11.5</m>.  The graphs of two lines are drawn in the first quadrant.  One line is  <m>\ds y=-2x+5</m>, from <m>x=0</m> to <m>2.5</m>.  The second line is <m>\ds y=-\frac{x}{2}+5</m>, from <m>x=0</m> to <m>10</m>.  The shaded region is bounded by the two curves and the <m>x</m> axis.
        </p>
        </description>
        <latex-image label="img_07_rev_image_05">
          \begin{tikzpicture}
          \begin{axis}[axis on top,xtick={2,4,6,8,10},xticklabels={$2$,$4$,$6$,$8$,$10$},ytick={1,2,3,4,5},yticklabels={$1$,$2$,$3$,$4$,$5$},ymin=0,ymax=5.5,xmin=0,xmax=11.5]
            \addplot [name path=A,firstcurvestyle,secondcolor,domain=0:2.5,samples=100] {-2*x+5};
            \addplot [name path=B,firstcurvestyle,domain=0:10,samples=100] {-0.5*x+5};
            \addplot [firstcurvestyle,areastyle] fill between [of=A and B,soft clip={domain=0:2.5}];
            \addplot [firstcurvestyle,areastyle,domain=2.5:10] {-0.5*x+5} \closedcycle;
            \draw (axis cs:4.5,0.5) node { \(y=-2x+5\)};
            \draw (axis cs:7,3) node { \(y=-\frac{x}{2}+5\)};
            \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
      </introduction>
