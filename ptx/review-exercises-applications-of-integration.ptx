  <exercise label="ex-volume-review-6">
<!--    <webwork xml:id="webwork-ex-volume-review-6">
          <pg-code>
          </pg-code>-->
      <introduction>
      <image width="75%">
        <shortdescription> Graph of intersecting curves in first quadrant.
        </shortdescription>
        <description>
        <p>The <m>y</m> axis is drawn from <m>0</m> to <m>1.5</m> and the <m>x</m> axis is drawn from <m>0</m> to <m>1.5</m>.  The graphs of two curves are drawn in the first quadrant.  One curve is  <m>\ds y=\frac{1}{1+x^2}</m>, from <m>x=0</m> to <m>1.25</m>.  The second curve is <m>\ds y=\frac{\sqrt{x}}{2}</m>, from <m>x=0</m> to <m>1.25</m>.  The shaded region is bounded by the two curves and the <m>y</m> axis.
        </p>
        </description>
        <latex-image label="img_07_rev_image_06">
          \begin{tikzpicture}
          \begin{axis}[axis on top,xtick={0.5,1},xticklabels={$\frac{1}{2}$,$1$},ytick={0.5,1},yticklabels={$\frac{1}{2}$,$1$},ymin=0,ymax=1.5,xmin=0,xmax=1.5]
            \addplot [name path=A,firstcurvestyle,domain=0:1.25,samples=100] {1/(1+x^2)};
            \addplot [name path=B,firstcurvestyle,secondcolor,domain=0:1.25,samples=100] {0.5*(x^(0.5)))};
            \addplot [firstcurvestyle,areastyle] fill between [of=A and B,soft clip={domain=0:1}];
            \draw (axis cs:0.5,1.1) node { \(\ds y=\frac{1}{1+x^2}\)};
            \draw (axis cs:0.75,0.25) node { \(\ds y=\frac{\sqrt{x}}{2}\)};
            \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
      </introduction>
