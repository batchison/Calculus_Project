<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="exercises-sequences-and-series-review">
    <title>Review Exercises</title>
    
<exercisegroup xml:id="exset-sequence-nth-term-review">
      <introduction>
        <p>
        Determine the <m>n^{\text{th}}</m> term of the given sequence.
        </p>
      </introduction>
      <exercise label="ex-sequence-nth-term-review-1">
<!--    <webwork xml:id="webwork-ex-sequence-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{3}{2},\, -\frac{3}{4},\, \frac{3}{8},\, -\frac{3}{16},\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{3(-1)^{n+1}}{2^n}\right\}_{n=1}^{\infty}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-nth-term-review-2">
<!--    <webwork xml:id="webwork-ex-sequence-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{1}{2},\, 2,\, \frac{3}{2},\, 4,\, \frac{5}{2},\, 6,\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{2n}{3+(-1)^{n+1}}\right\}_{n=1}^{\infty} </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
  </exercises>
