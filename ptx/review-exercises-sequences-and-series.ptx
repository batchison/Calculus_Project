<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="exercises-sequences-and-series-review">
    <title>Review Exercises</title>
    
<exercisegroup xml:id="exset-sequence-nth-term-review">
      <introduction>
        <p>
        Determine the <m>n^{\text{th}}</m> term of the given sequence.
        </p>
      </introduction>
      <exercise label="ex-sequence-nth-term-review-1">
<!--    <webwork xml:id="webwork-ex-sequence-nth-term-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{2}{3},\, \frac{4}{5},\, \frac{8}{7},\, \frac{16}{9},\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{2^n}{2n+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-nth-term-review-2">
<!--    <webwork xml:id="webwork-ex-sequence-nth-term-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{3}{2},\, -\frac{3}{4},\, \frac{3}{8},\, -\frac{3}{16},\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{-3\left(\frac{-1}{2}\right)^n\right\}_{n=1}^{\infty}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-nth-term-review-3">
<!--    <webwork xml:id="webwork-ex-sequence-nth-term-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{1}{2},\, 2,\, \frac{3}{2},\, 4,\, \frac{5}{2},\, 6,\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{2n}{3+(-1)^{n+1}}\right\}_{n=1}^{\infty} </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-nth-term-review-4">
<!--    <webwork xml:id="webwork-ex-sequence-nth-term-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{-1}{2^2-1^2},\, 0,\, \frac{1}{4^2-3^2},\, \frac{2}{5^2-4^2},\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{n-2}{2n+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-nth-term-review-5">
<!--    <webwork xml:id="webwork-ex-sequence-nth-term-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{1}{5},\, \frac{2}{3},\, 1,\, \frac{5}{4},\, \frac{13}{9},\, \frac{8}{5},\, \frac{19}{11},\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{3n-2}{n+4}\right\}_{n=1}^{\infty} </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-nth-term-review-6">
<!--    <webwork xml:id="webwork-ex-sequence-nth-term-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{\sqrt{2}}{2},\, \frac{1}{2},\, \frac{\sqrt{2}}{6},\, 0,\, -\frac{\sqrt{2}}{10},\, -\frac{1}{6},\, -\frac{\sqrt{2}}{14},\, 0,\, \ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \left\{\frac{\sin\left(\frac{n\pi}{4}\right)}{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
<exercisegroup cols="2" xml:id="exset-sequence-limit-review">
      <introduction>
        <p>
        Determine whether the sequence converges or diverges.  If convergent, give the limit of the sequence.
        </p>
      </introduction>
      <exercise label="ex-sequence-limit-review-1">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{1-2n}{n+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds -2</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-2">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{2n-1}{2-n^3}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-3">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{3n^2-1}{n^3+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-4">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{2-n}{n}-\frac{n}{n-1}\right\}_{n=2}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds -2</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-5">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{2^n}{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            diverges
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-6">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{1+\frac{5}{n^2+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 1</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-7">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-7">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{1}{n}-\frac{5}{n^2+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-8">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-8">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{1}{n+2}-\frac{1}{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-9">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-9">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{1}{n}-\frac{1}{e^n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-10">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-10">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\cos^2\left(\frac{n\pi}{6}\right)\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            diverges
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-11">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-11">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\tan^{-1}(n)\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds \frac{\pi}{2}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-12">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-12">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{\sqrt{n}}{\ln(n)}\right\}_{n=2}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            diverges
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-13">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-13">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{(-1)^{n}\ln\left(\frac{1}{n}\right)\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            diverges
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-14">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-14">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{\sqrt{n}}{e^{2n}}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-15">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-15">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{e^n}{1-2n^{\frac{3}{2}}}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            diverges
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-limit-review-16">
<!--    <webwork xml:id="webwork-ex-sequence-limit-review-16">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n\ln(n)}{2-n^2}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            converges to <m>\ds 0</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
</exercisegroup>
<exercisegroup cols="2" xml:id="exset-sequence-bounded-review">
      <introduction>
        <p>
        Determine whether the sequence is bounded, bounded above, bounded below, or none of the above.
        </p>
      </introduction>
      <exercise label="ex-sequence-bounded-review-1">
<!--    <webwork xml:id="webwork-ex-sequence-bounded-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{5+\frac{(-1)^n}{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            bounded
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-bounded-review-2">
<!--    <webwork xml:id="webwork-ex-sequence-bounded-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{(-1)^n\sqrt{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            neither bounded above or below
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-bounded-review-3">
<!--    <webwork xml:id="webwork-ex-sequence-bounded-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{\sin(n)}{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            bounded
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-bounded-review-4">
<!--    <webwork xml:id="webwork-ex-sequence-bounded-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n}{\cos^2(n)}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            bounded below
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-bounded-review-5">
<!--    <webwork xml:id="webwork-ex-sequence-bounded-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{3n^2-1}{n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            bounded below
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-bounded-review-6">
<!--    <webwork xml:id="webwork-ex-sequence-bounded-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n^2-2}{n^2+2n+2}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            bounded
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
</exercisegroup>
<exercisegroup cols="2" xml:id="exset-sequence-monotone-review">
      <introduction>
        <p>
        Determine whether the sequence is monotonically increasing or decreasing.  If it is not, determine if there is an <m>m</m> such that it is monotonic for all <m>n\geq m</m>.
        </p>
      </introduction>
      <exercise label="ex-sequence-monotone-review-1">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n+2}{n+1}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            decreasing
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-2">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\ln(n)\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            increasing
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-3">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n-6}{2n-7}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            increasing for all <m>n\neq 3</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-4">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n-6}{3n-20}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            decreasing for all <m>n\neq 6</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-5">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n}{(2n-5)^2}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            decreasing for all <m>n\geq 3</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-6">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{2n-3}{e^n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            decreasing for all <m>n\geq 3</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-7">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-7">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{n!}{\pi^n}\right\}_{n=1}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            increasing for all <m>n\geq 3</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-sequence-monotone-review-8">
<!--    <webwork xml:id="webwork-ex-sequence-monotone-review-8">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \left\{\frac{\pi^n}{(n-2)!}\right\}_{n=3}^{\infty} </m>
            </p>
          </statement>
          <answer>
            <p>
            decreasing for all <m>n\geq 5</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
    </exercisegroup>
<exercisegroup cols="2" xml:id="exset-geometric-series-review">
      <introduction>
        <p>
        Express each of the given geometric series as <m>\ds \sum_{n=0}^{\infty}ar^n,</m> where <m>a</m> is a non-zero constant and determine whether the series converges or diverges.  If it converges, state what it converges to.
        </p>
      </introduction>
      <exercise label="ex-geometric-series-review-1">
<!--    <webwork xml:id="webwork-ex-geometric-series-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \sum_{n=2}^{\infty}\left(\frac{1}{5}\right)^{n+1}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\frac{1}{125}\left(\frac{1}{5}\right)^{n}= \frac{1}{100}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-series-review-2">
<!--    <webwork xml:id="webwork-ex-geometric-series-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \sum_{n=2}^{\infty}\frac{3(-1)^n}{2^{n+1}}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\frac{3}{8}\left(-\frac{1}{2}\right)^{n}= \frac{1}{4}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-series-review-3">
<!--    <webwork xml:id="webwork-ex-geometric-series-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \sum_{n=1}^{\infty}\frac{3}{2}\left(\frac{4}{5}\right)^n</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\frac{6}{5}\left(\frac{4}{5}\right)^{n}=6 </m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-series-review-4">
<!--    <webwork xml:id="webwork-ex-geometric-series-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \sum_{n=1}^{\infty}\frac{e^{n+1}}{\pi^{n-1}}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}e^2\left(\frac{e}{\pi}\right)^{n}=\frac{e^2\pi}{\pi-e}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-series-review-5">
<!--    <webwork xml:id="webwork-ex-geometric-series-review-5">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \sum_{n=1}^{\infty}\left(\frac{5}{2}\right)^{1-n}</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\left(\frac{2}{5}\right)^{n}=-\frac{5}{3}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-series-review-6">
<!--    <webwork xml:id="webwork-ex-geometric-series-review-6">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \sum_{n=1}^{\infty}\left(\frac{1}{3^{n+1}}-\frac{1}{3^n}\right)</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\frac{-2}{9}\left(\frac{1}{3}\right)^{n}=-\frac{1}{3}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
</exercisegroup>
<exercise label="ex-geometric-series-decimal-1">
<!--    <webwork xml:id="webwork-ex-geometric-series-decimal-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            Express <m>0.\overline{45}</m> as a convergent geometric series and find its equivalent fraction.
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\frac{9}{20}\left(\frac{1}{100}\right)^{n}=\frac{38}{11}</m>
            </p>
          </answer>
<!--    </webwork>-->
</exercise>
<exercisegroup xml:id="exset-geometric-closed-form-review">
      <introduction>
        <p>
        Express each of the given geometric series as <m>\ds \sum_{n=0}^{\infty}ar^n,</m> where <m>a</m> is a non-zero constant and determine whether the series converges or diverges.  If it converges, state what it converges to.
        </p>
      </introduction>
      <exercise label="ex-geometric-closed-form-review-1">
<!--    <webwork xml:id="webwork-ex-geometric-closed-form-review-1">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds 12+10+\frac{25}{3}+\frac{125}{18}+\frac{625}{108}+\ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}12\left(\frac{5}{6}\right)^{n}= 72</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-closed-form-review-2">
<!--    <webwork xml:id="webwork-ex-geometric-closed-form-review-2">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds -6+3-\frac{3}{2}+\frac{3}{4}-\frac{3}{8}+\ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}-6\left(-\frac{1}{2}\right)^{n}= -4</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-closed-form-review-3">
<!--    <webwork xml:id="webwork-ex-geometric-closed-form-review-3">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds \frac{3}{8}-\frac{1}{2}+\frac{2}{3}-\frac{8}{9}+\frac{32}{27}-\ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}\frac{3}{8}\left(-\frac{4}{3}\right)^{n}</m> diverges
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
      <exercise label="ex-geometric-closed-form-review-4">
<!--    <webwork xml:id="webwork-ex-geometric-closed-form-review-4">
          <pg-code>
          </pg-code>-->
          <statement>
            <p>
            <m>\ds 12-10+\frac{25}{3}-\frac{125}{18}+\frac{625}{108}-\ldots</m>
            </p>
          </statement>
          <answer>
            <p>
            <m>\ds \sum_{n=0}^{\infty}12\left(-\frac{5}{6}\right)^{n}=\frac{72}{11}</m>
            </p>
          </answer>
<!--    </webwork>-->
      </exercise>
</exercisegroup>
</exercises>
